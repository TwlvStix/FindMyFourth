{
  "name": "cloud-functions",
  "description": "Firebase Cloud Functions",
  "dependencies": {
    "@google-cloud/tasks": "^6.2.1",
    "sharp": "^0.33.2",
    "@langchain/anthropic": "^0.1.1",
    "@langchain/core": "^0.3.19",
    "@langchain/google-genai": "^0.0.8",
    "@langchain/langgraph": "^0.2.23",
    "@langchain/openai": "^0.3.14",
    "@mux/mux-node": "^7.3.3",
    "@onesignal/node-onesignal": "^2.0.1-beta2",
    "@sendgrid/mail": "^8.0.0",
    "axios": "1.12.0",
    "braintree": "^3.6.0",
    "firebase-admin": "^11.11.0",
    "firebase-functions": "^7.0.6",
    "qs": "^6.7.0",
    "razorpay": "^2.8.4",
    "jsonwebtoken": "^9.0.2",
    "stripe": "^8.0.1"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "eslint-plugin-promise": "^4.2.1",
    "jest": "^29.0.0"
  },
  "scripts": {
    "test": "jest --testPathPattern=test/",
    "lint": "./node_modules/.bin/eslint --max-warnings=30 .",
    "serve": "firebase -P find-my-fourth emulators:start --only functions",
    "shell": "firebase -P find-my-fourth functions:shell",
    "start": "npm run shell",
    "logs": "firebase -P find-my-fourth functions:log",
    "compile": "cp ../../tsconfig.template.json ./tsconfig-compile.json && tsc --project tsconfig-compile.json",
    "load-test": "node --max-old-space-size=4096 test/load-test.js",
    "load-test:small": "node --max-old-space-size=2048 test/load-test.js --small",
    "load-test:cleanup": "node test/load-test.js --cleanup",
    "notif-load-test": "jest test/notification-load.test.js --testTimeout=300000",
    "notif-load-test:small": "NOTIF_LOAD_TEST_SMALL=true jest test/notification-load.test.js --testTimeout=60000"
  },
  "engines": {
    "node": "20"
  },
  "private": true
}
