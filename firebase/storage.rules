rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Chat images — any authenticated user may upload (max 5 MB, images only).
    // Firestore rules enforce chat membership on the message write, so
    // a rogue upload without a matching Firestore write goes nowhere.
    match /chat_images/{chatId}/{fileName} {
      allow read: if request.auth != null;

      allow create: if request.auth != null &&
                       request.resource.size < 5 * 1024 * 1024 &&
                       request.resource.contentType.matches('image/.*');

      allow delete: if request.auth != null;
    }

    // Profile photos — owner only
    match /users/{userId}/profile_photos/{fileName} {
      allow read: if request.auth != null;
      allow create, delete: if request.auth != null && request.auth.uid == userId;
    }
  }
}
