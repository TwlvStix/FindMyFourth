rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isChatMember(data) {
      return isSignedIn() && request.auth.uid in data.memberIds;
    }

    function isLegacyChatMember(data) {
      return isSignedIn() &&
        data.users is list &&
        data.users.hasAny([/databases/$(database)/documents/users/$(request.auth.uid)]);
    }

    function hasValidChatType(data) {
      return data.type in ['direct', 'game'];
    }

    function hasValidMemberIds(data) {
      return data.memberIds is list && data.memberIds.size() >= 1;
    }

    function hasValidDirectKey(data) {
      return data.memberIds.size() == 2 &&
        data.directKey is string &&
        ((data.memberIds[0] < data.memberIds[1] &&
          data.directKey == data.memberIds[0] + '_' + data.memberIds[1]) ||
         (data.memberIds[1] < data.memberIds[0] &&
          data.directKey == data.memberIds[1] + '_' + data.memberIds[0]));
    }

    function userRef(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function isSelfFriendChange() {
      let self = userRef(request.auth.uid);
      return request.resource.data.friends is list &&
        request.resource.data.diff(resource.data).changedKeys().hasOnly(['friends']) &&
        ((request.resource.data.friends.hasAny([self]) &&
          !(resource.data.friends is list && resource.data.friends.hasAny([self]))) ||
         ((resource.data.friends is list && resource.data.friends.hasAny([self])) &&
          !request.resource.data.friends.hasAny([self])));
    }

    function isSelfFriendRequestChange() {
      let self = userRef(request.auth.uid);
      let selfId = request.auth.uid;
      let nextHasSelf = request.resource.data.friend_requests.hasAny([self]) ||
        request.resource.data.friend_requests.hasAny([selfId]);
      let prevHasSelf = resource.data.friend_requests is list &&
        (resource.data.friend_requests.hasAny([self]) ||
         resource.data.friend_requests.hasAny([selfId]));
      return request.resource.data.friend_requests is list &&
        request.resource.data.diff(resource.data).changedKeys().hasOnly(['friend_requests']) &&
        ((nextHasSelf && !prevHasSelf) || (prevHasSelf && !nextHasSelf));
    }

    function canUpdateUnreadCount(oldData, newData) {
      let oldCounts = oldData.get('unreadCountByUser', {});
      let newCounts = newData.get('unreadCountByUser', {});
      // User can reset their own count to 0 or decrement it
      // Others' counts can only increment by 1 (for new messages)
      return !newCounts.keys().hasAny([request.auth.uid]) ||
        newCounts[request.auth.uid] <= oldCounts.get(request.auth.uid, 0);
    }

    function allowedUserFieldChangesOnly() {
      let allowedFields = [
        'first_name',
        'last_name',
        'phone_number',
        'photo_url',
        'handicap',
        'home_course',
        'music',
        'drinks',
        'display_name',
        'shortDescription',
        'title',
        'notify_all',
        'notify_money_game',
        'notify_vegas_game',
        'notify_competitive_game',
        'notify_for_fun',
        'notify_only_from_friends',
        'notify_member_discount',
        'notify_off',
        'pace_of_play',
        'play_for_money'
      ];
      let changed = request.resource.data.diff(resource.data).changedKeys();
      return changed.hasOnly(allowedFields);
    }

    function roleUnchanged() {
      return !request.resource.data.diff(resource.data).changedKeys().hasAny(['role']);
    }

    function displayNameChangeAllowed() {
      let desired = request.resource.data.display_name;
      let current = resource.data.display_name;
      let usernameDoc = get(/databases/$(database)/documents/usernames/$(desired));
      return desired == current ||
        (desired is string && desired != '' &&
         ((!usernameDoc.exists && current == null) ||
          (usernameDoc.exists &&
           (usernameDoc.data.uid == userRef(request.auth.uid) ||
            usernameDoc.data.uid == request.auth.uid))));
    }

    match /users/{document} {
      allow update: if roleUnchanged() &&
        ((request.auth.uid == document &&
          allowedUserFieldChangesOnly() &&
          (displayNameChangeAllowed() ||
           !request.resource.data.diff(resource.data).changedKeys().hasAny(['display_name']))) ||
          (request.auth != null &&
            (isSelfFriendChange() || isSelfFriendRequestChange())));
      allow create: if request.auth.uid == document;
      allow read: if request.auth != null;
      allow delete: if false;
    }

    match /course/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if false;
      allow delete: if false;
    }

    match /chats/{chatId} {
      // Allow create if user is authenticated and is in memberIds
      allow create: if isSignedIn() &&
        hasValidMemberIds(request.resource.data) &&
        hasValidChatType(request.resource.data) &&
        request.auth.uid in request.resource.data.memberIds &&
        (request.resource.data.type != 'direct' ||
          hasValidDirectKey(request.resource.data));

      // Allow read if:
      // 1. Document exists and user is a member, OR
      // 2. Document doesn't exist (allows checking for existence during creation)
      allow read: if isSignedIn() && (
        !exists(/databases/$(database)/documents/chats/$(chatId)) ||
        isChatMember(resource.data) ||
        isLegacyChatMember(resource.data)
      );

      // Allow update if user is a member and follows update rules
      allow update: if isSignedIn() &&
        isChatMember(resource.data) &&
        request.auth.uid in request.resource.data.memberIds &&
        canUpdateUnreadCount(resource.data, request.resource.data) &&
        request.resource.data.type == resource.data.type &&
        (resource.data.type != 'direct' ||
          request.resource.data.memberIds == resource.data.memberIds) &&
        (resource.data.type != 'direct' ||
          request.resource.data.directKey == resource.data.directKey) &&
        (resource.data.type == 'direct' ||
          request.resource.data.memberIds.hasAll(resource.data.memberIds) ||
          resource.data.memberIds.hasAll(request.resource.data.memberIds));

      // Allow delete if user is a member of the chat
      allow delete: if isSignedIn() && isChatMember(resource.data);

      match /messages/{messageId} {
        allow read: if isSignedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.memberIds;
        allow create: if isSignedIn() &&
          request.resource.data.senderId == request.auth.uid &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.memberIds;
        // Allow update/delete if sender OR if user is a chat member (for bulk deletion)
        allow update, delete: if isSignedIn() && (
          resource.data.senderId == request.auth.uid ||
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.memberIds
        );
      }
    }

    // Legacy collection - read-only for backward compatibility
    // All new messages use chats/{chatId}/messages subcollection
    match /chat_messages/{messageId} {
      allow read: if isSignedIn() &&
        resource.data.user.id == request.auth.uid;
      allow create, update, delete: if false;
    }

    match /games/{document} {
      allow create: if request.auth != null;
      allow read: if true;
      allow write: if request.auth != null;
      allow delete: if request.auth != null;
    }

    match /friend_request/{document} {
      allow create: if request.auth != null;
      allow read: if request.auth != null;
      allow write: if request.auth != null;
      allow delete: if request.auth != null;
    }

    match /usernames/{name} {
      allow create: if request.auth != null &&
        (request.resource.data.uid == userRef(request.auth.uid) ||
         request.resource.data.uid == request.auth.uid) &&
        !exists(/databases/$(database)/documents/usernames/$(name));
      allow read: if request.auth != null;
      allow update: if false;
      allow delete: if false;
    }

    match /games/{parent}/addPlayers/{document} {
      allow create: if request.auth != null;
      allow read: if request.auth != null;
      allow write: if request.auth != null;
      allow delete: if false;
    }

    match /{path=**}/addPlayers/{document} {
      allow read: if request.auth != null;
    }


    match /user_push_notifications/{id} {
      allow read, update, delete: if false;
      allow create: if /databases/$(database)/documents/users/$(request.auth.uid) == request.resource.data.sender;
    }
  }
}
