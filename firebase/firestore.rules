rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isChatMember(data) {
      return isSignedIn() && request.auth.uid in data.memberIds;
    }


    function hasValidChatType(data) {
      return data.type in ['direct', 'game'];
    }

    function hasValidMemberIds(data) {
      return data.memberIds is list && data.memberIds.size() >= 1;
    }

    function hasValidDirectKey(data) {
      return data.memberIds.size() == 2 &&
        data.directKey is string &&
        ((data.memberIds[0] < data.memberIds[1] &&
          data.directKey == data.memberIds[0] + '_' + data.memberIds[1]) ||
         (data.memberIds[1] < data.memberIds[0] &&
          data.directKey == data.memberIds[1] + '_' + data.memberIds[0]));
    }

    function userRef(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function isGameParticipant(gameId) {
      let gamePath = /databases/$(database)/documents/games/$(gameId);
      let gameExists = gameId is string && exists(gamePath);
      let gameData = gameExists ? get(gamePath).data : {};
      return isSignedIn() &&
        gameExists &&
        gameData.joined_players is list &&
        gameData.joined_players.hasAny([
          userRef(request.auth.uid),
          request.auth.uid
        ]);
    }

    function isChatMemberById(chatId) {
      let chatPath = /databases/$(database)/documents/chats/$(chatId);
      let chatExists = exists(chatPath);
      let chatData = chatExists ? get(chatPath).data : {};
      return chatExists &&
        chatData.memberIds is list &&
        request.auth.uid in chatData.memberIds;
    }

    function chatDataById(chatId) {
      let chatPath = /databases/$(database)/documents/chats/$(chatId);
      return exists(chatPath) ? get(chatPath).data : {};
    }

    function isChatMemberUid(chatId, uid) {
      let chatData = chatDataById(chatId);
      return chatData.memberIds is list &&
        chatData.memberIds.hasAny([uid]);
    }

    function isGameChatOwnerById(chatId) {
      let chatData = chatDataById(chatId);
      return chatData.type == 'game' &&
        isGameOwnerForChat(chatData);
    }

    function listHasSelf(listValue) {
      return listValue.hasAny([userRef(request.auth.uid), request.auth.uid]);
    }

    function listHasSelfRef(listValue) {
      return listValue.hasAny([userRef(request.auth.uid)]);
    }

    function listHasSelfUid(listValue) {
      return listValue.hasAny([request.auth.uid]);
    }

    function isSelfOnlyAdded(oldList, newList) {
      return !listHasSelf(oldList) &&
        listHasSelf(newList) &&
        newList.size() == oldList.size() + 1 &&
        newList.hasAll(oldList);
    }

    function isSelfOnlyRemoved(oldList, newList) {
      let removedRef = listHasSelfRef(oldList) && !listHasSelfRef(newList);
      let removedUid = listHasSelfUid(oldList) && !listHasSelfUid(newList);
      let removedCount = (removedRef ? 1 : 0) + (removedUid ? 1 : 0);
      return (removedRef || removedUid) &&
        !listHasSelf(newList) &&
        oldList.size() == newList.size() + removedCount &&
        oldList.hasAll(newList);
    }

    function isSelfScopedListChange(oldValue, newValue) {
      let oldList = oldValue is list ? oldValue : [];
      return newValue is list &&
        (isSelfOnlyAdded(oldList, newValue) ||
         isSelfOnlyRemoved(oldList, newValue));
    }

    function isSelfFriendChange(documentId) {
      let changedKeys = request.resource.data.diff(resource.data).changedKeys();
      return request.auth.uid != documentId &&
        changedKeys.hasOnly(['friends']) &&
        isSelfScopedListChange(resource.data.friends, request.resource.data.friends);
    }

    function isSelfFriendRequestChange(documentId) {
      let changedKeys = request.resource.data.diff(resource.data).changedKeys();
      return request.auth.uid != documentId &&
        changedKeys.hasOnly(['friend_requests']) &&
        isSelfScopedListChange(resource.data.friend_requests, request.resource.data.friend_requests);
    }

    function isSelfReference(value) {
      return value == userRef(request.auth.uid) || value == request.auth.uid;
    }

    function isFriendRequestParticipant(data) {
      return isSignedIn() &&
        (isSelfReference(data.requester_id) ||
         isSelfReference(data.receiver_id));
    }

    function canUpdateUnreadCount(oldData, newData) {
      let oldCounts = oldData.get('unreadCountByUser', {});
      let newCounts = newData.get('unreadCountByUser', {});
      // User can reset their own count to 0 or decrement it
      // Others' counts can only increment by 1 (for new messages)
      return !newCounts.keys().hasAny([request.auth.uid]) ||
        newCounts[request.auth.uid] <= oldCounts.get(request.auth.uid, 0);
    }

    function chatMemberIds(data) {
      return data.memberIds is list ? data.memberIds : [];
    }


    function isGameChat(data) {
      return data.type == 'game';
    }

    function isGameOwnerForChat(data) {
      let gamePath = /databases/$(database)/documents/games/$(data.gameId);
      let gameExists = data.gameId is string && exists(gamePath);
      let gameData = gameExists ? get(gamePath).data : {};
      return isSignedIn() && gameExists && gameData.uid == request.auth.uid;
    }

    function isSelfOnlyAddedToChat(oldData, newData) {
      return isSelfOnlyAdded(chatMemberIds(oldData), chatMemberIds(newData));
    }

    function isSelfOnlyRemovedFromChat(oldData, newData) {
      return isSelfOnlyRemoved(chatMemberIds(oldData), chatMemberIds(newData));
    }

    function canUpdateChatMetadata(oldData, newData) {
      let changed = newData.diff(oldData).changedKeys();
      return isChatMember(oldData) &&
        changed.hasOnly([
          'last_message',
          'lastMessage',
          'lastMessageAt',
          'lastMessageSenderId',
          'unreadCountByUser',
          'updatedAt',
          'typingUsers'
        ]) &&
        (!changed.hasAny(['lastMessageSenderId']) ||
          request.resource.data.lastMessageSenderId == request.auth.uid) &&
        (!changed.hasAny(['unreadCountByUser']) ||
          canUpdateUnreadCount(oldData, newData)) &&
        request.resource.data.type == oldData.type &&
        (oldData.type != 'direct' ||
          (request.resource.data.memberIds is list &&
            oldData.memberIds is list &&
            request.resource.data.memberIds == oldData.memberIds &&
            request.resource.data.directKey == oldData.directKey));
    }

    function canSelfJoinGameChat(oldData, newData) {
      let changedKeys = newData.diff(oldData).changedKeys();
      return isGameChat(oldData) &&
        isGameParticipant(oldData.gameId) &&
        isSelfOnlyAddedToChat(oldData, newData) &&
        changedKeys.hasOnly([
          'memberIds',
          'updatedAt',
          'unreadCountByUser'
        ]) &&
        canUpdateUnreadCount(oldData, newData);
    }

    function canSelfLeaveGameChat(oldData, newData) {
      let changedKeys = newData.diff(oldData).changedKeys();
      return isGameChat(oldData) &&
        isSelfOnlyRemovedFromChat(oldData, newData) &&
        changedKeys.hasOnly([
          'memberIds',
          'updatedAt'
        ]);
    }

    function canGameOwnerRemoveMember(oldData, newData) {
      let changedKeys = newData.diff(oldData).changedKeys();
      let oldMembers = chatMemberIds(oldData);
      let newMembers = chatMemberIds(newData);
      return isGameChat(oldData) &&
        isGameOwnerForChat(oldData) &&
        newMembers is list &&
        oldMembers.size() == newMembers.size() + 1 &&
        oldMembers.hasAll(newMembers) &&
        changedKeys.hasOnly([
          'memberIds',
          'updatedAt'
        ]);
    }

    function canGameOwnerUpdateChatManagement(oldData, newData) {
      let changedKeys = newData.diff(oldData).changedKeys();
      return isGameChat(oldData) &&
        isGameOwnerForChat(oldData) &&
        changedKeys.hasOnly([
          'isReadOnly',
          'pinnedMessage',
          'pinnedAt',
          'archivedAt'
        ]);
    }

    function isSelfOnlyAddedToReadBy(oldData, newData) {
      let oldReadBy = oldData.readBy is list ? oldData.readBy : [];
      let newReadBy = newData.readBy is list ? newData.readBy : [];
      return isSelfOnlyAdded(oldReadBy, newReadBy);
    }

    function readByChangeAllowed(oldData, newData) {
      let changed = newData.diff(oldData).changedKeys();
      return changed.hasOnly(['readBy']) &&
        isSelfOnlyAddedToReadBy(oldData, newData);
    }

    function messageSenderUpdateAllowed(oldData, newData) {
      let changed = newData.diff(oldData).changedKeys();
      return newData.senderId == oldData.senderId &&
        !changed.hasAny(['reactions']) &&
        (!changed.hasAny(['readBy']) ||
          isSelfOnlyAddedToReadBy(oldData, newData));
    }

    function allowedUserFieldChangesOnly() {
      let allowedFields = [
        'first_name',
        'last_name',
        'phone_number',
        'photo_url',
        'handicap',
        'home_course',
        'music',
        'drinks',
        'display_name',
        'display_name_lower',
        'display_name_lowercase',
        'friends',
        'friend_requests',
        'shortDescription',
        'title',
        'notify_all',
        'notify_money_game',
        'notify_vegas_game',
        'notify_competitive_game',
        'notify_for_fun',
        'notify_only_from_friends',
        'notify_member_discount',
        'notify_off',
        'notification_prefs',
        'pace_of_play',
        'play_for_money',
        'vibe_profile',
        'vibe_profile.importance',
        'vibe_profile.importance_version',
        'vibe_profile.importance_updated_at',
        'golf_canada_number'
      ];
      let changed = request.resource.data.diff(resource.data).changedKeys();
      return changed.hasOnly(allowedFields);
    }

    function allowedVibeProfileChangesOnly() {
      let newVibe = request.resource.data.vibe_profile;
      let oldVibe = resource.data.vibe_profile;
      let allowedKeys = [
        'prefs',
        'importance',
        'importance_version',
        'importance_updated_at',
        'confirmed_at'
      ];
      return !(newVibe is map) ||
        ((oldVibe is map)
          ? newVibe.diff(oldVibe).changedKeys().hasOnly(allowedKeys)
          : newVibe.keys().hasOnly(allowedKeys));
    }

    function roleUnchanged() {
      return !request.resource.data.diff(resource.data).changedKeys().hasAny(['role']);
    }

    function displayNameChangeAllowed() {
      let desired = request.resource.data.display_name;
      let current = resource.data.display_name;
      let usernameDoc = get(/databases/$(database)/documents/usernames/$(desired));
      return desired == current ||
        (desired is string && desired != '' &&
         ((!usernameDoc.exists && current == null) ||
          (usernameDoc.exists &&
           (usernameDoc.data.uid == userRef(request.auth.uid) ||
            usernameDoc.data.uid == request.auth.uid))));
    }

    // Game-related helper functions
    function joinedPlayers(data) {
      return data.joined_players is list ? data.joined_players : [];
    }

    function guestPlayers(data) {
      return data.guest_players is list ? data.guest_players : [];
    }

    function maxPlayers(data) {
      return data.max_players is int ? data.max_players : 0;
    }

    function totalPlayers(data) {
      return joinedPlayers(data).size() + guestPlayers(data).size();
    }

    function containsSelf(playersList) {
      return playersList.hasAny([
        userRef(request.auth.uid),
        request.auth.uid
      ]);
    }

    function isOwner(data) {
      return isSignedIn() &&
        data.uid is string &&
        data.uid == request.auth.uid;
    }

    function isParticipant(data) {
      return isSignedIn() && containsSelf(joinedPlayers(data));
    }

    function isPublicGame(data) {
      return !data.keys().hasAny(['friend_game']) ||
        data.friend_game == 'Public' ||
        data.friend_game == 'public';
    }

    function isFriendsOnlyGame(data) {
      return data.friend_game == 'Friends' ||
        data.friend_game == 'friends';
    }

    function isFriendOfOwner(data) {
      let ownerPath = userRef(data.uid);
      let ownerExists = data.uid is string && exists(ownerPath);
      let ownerData = ownerExists ? get(ownerPath).data : {};
      return ownerExists &&
        ownerData.friends is list &&
        ownerData.friends.hasAny([userRef(request.auth.uid), request.auth.uid]);
    }

    function canJoinVisibility(data) {
      return isPublicGame(data) ||
        (isFriendsOnlyGame(data) && isFriendOfOwner(data));
    }

    function statusIsActive(data) {
      return !data.keys().hasAny(['status']) || data.status == 'active';
    }

    function isCancelled(data) {
      return data.isCancelled == true;
    }

    function isOpenForJoin(data) {
      return statusIsActive(data) && !isCancelled(data);
    }

    function isValidStatus(data) {
      return !data.keys().hasAny(['status']) ||
        (data.status is string &&
          data.status in ['active', 'completed', 'cancelled', 'expired']);
    }

    function isCancelStatusConsistent(data) {
      return !(data.status == 'cancelled') || data.isCancelled == true;
    }

    function userRefMatchesUid(data) {
      return !data.keys().hasAny(['userRef']) ||
        data.userRef == userRef(data.uid);
    }

    function ownerUpdateAllowed() {
      let changed = request.resource.data.diff(resource.data).changedKeys();
      return isOwner(resource.data) &&
        request.resource.data.uid == resource.data.uid &&
        userRefMatchesUid(request.resource.data) &&
        changed.hasOnly([
          'name_game',
          'date',
          'num_players',
          'style_game',
          'game_type',
          'course_play',
          'member_discount',
          'scoring',
          'friend_game',
          'max_players',
          'rules_setting',
          'courseRef',
          'chatRef',
          'isCancelled',
          'status',
          'joined_players',
          'guest_players',
          'userRef'
        ]) &&
        maxPlayers(request.resource.data) >= totalPlayers(request.resource.data) &&
        isValidStatus(request.resource.data) &&
        isCancelStatusConsistent(request.resource.data);
    }

    function participantJoinAllowed() {
      let changed = request.resource.data.diff(resource.data).changedKeys();
      return isSignedIn() &&
        isOpenForJoin(resource.data) &&
        canJoinVisibility(resource.data) &&
        changed.hasOnly(['joined_players']) &&
        request.resource.data.joined_players is list &&
        !containsSelf(joinedPlayers(resource.data)) &&
        containsSelf(joinedPlayers(request.resource.data)) &&
        request.resource.data.joined_players.size() ==
          joinedPlayers(resource.data).size() + 1 &&
        request.resource.data.joined_players.hasAll(joinedPlayers(resource.data)) &&
        maxPlayers(request.resource.data) >= totalPlayers(request.resource.data);
    }

    function participantLeaveAllowed() {
      let changed = request.resource.data.diff(resource.data).changedKeys();
      return isSignedIn() &&
        changed.hasOnly(['joined_players']) &&
        request.resource.data.joined_players is list &&
        containsSelf(joinedPlayers(resource.data)) &&
        !containsSelf(joinedPlayers(request.resource.data)) &&
        request.resource.data.joined_players.size() ==
          joinedPlayers(resource.data).size() - 1 &&
        joinedPlayers(resource.data).hasAll(
          request.resource.data.joined_players
        );
    }

    match /users/{document} {
      allow update: if roleUnchanged() &&
        ((request.auth.uid == document &&
          allowedUserFieldChangesOnly() &&
          (!request.resource.data.diff(resource.data).changedKeys().hasAny(['vibe_profile']) ||
            allowedVibeProfileChangesOnly()) &&
          (displayNameChangeAllowed() ||
           !request.resource.data.diff(resource.data).changedKeys().hasAny(['display_name']))) ||
          isSelfFriendRequestChange(document) ||
          isSelfFriendChange(document));
      allow create: if request.auth.uid == document;
      allow read: if request.auth != null;
      allow delete: if false;

      match /devices/{deviceId} {
        allow create, update, read, delete: if request.auth.uid == document;
      }

      match /chatRefs/{chatId} {
        allow read: if request.auth.uid == document;
        allow create, update: if isSignedIn() &&
          isChatMemberById(chatId) &&
          isChatMemberUid(chatId, document) &&
          request.resource.data.keys().hasOnly(['chatId', 'lastMessageAt']) &&
          request.resource.data.chatId == chatId;
        allow delete: if request.auth.uid == document;
      }

      match /notifications/{notificationId} {
        allow read: if request.auth.uid == document;
        allow update: if request.auth.uid == document &&
          request.resource.data.diff(resource.data).changedKeys()
            .hasOnly(['read']);
        allow delete: if request.auth.uid == document;
      }
    }

    match /course/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if false;
      allow delete: if false;
    }

    match /chats/{chatId} {
      // Allow create if user is authenticated and is in memberIds
      allow create: if isSignedIn() &&
        hasValidMemberIds(request.resource.data) &&
        hasValidChatType(request.resource.data) &&
        request.auth.uid in request.resource.data.memberIds &&
        (request.resource.data.type != 'direct' ||
          hasValidDirectKey(request.resource.data));

      // Allow read if:
      // 1. Document exists and user is a member, OR
      // 2. Document doesn't exist (allows checking for existence during creation)
      allow read: if isSignedIn() && (
        !exists(/databases/$(database)/documents/chats/$(chatId)) ||
        isChatMember(resource.data)
      );

      // Allow update for strict metadata changes or controlled membership changes
      allow update: if isSignedIn() && (
        canUpdateChatMetadata(resource.data, request.resource.data) ||
        canSelfJoinGameChat(resource.data, request.resource.data) ||
        canSelfLeaveGameChat(resource.data, request.resource.data) ||
        canGameOwnerRemoveMember(resource.data, request.resource.data) ||
        canGameOwnerUpdateChatManagement(resource.data, request.resource.data)
      );

      // Allow delete: game owner for game chats; members for direct chats
      allow delete: if isSignedIn() && (
        (resource.data.type == 'game' && isGameOwnerForChat(resource.data)) ||
        (resource.data.type != 'game' && isChatMember(resource.data))
      );

      match /messages/{messageId} {
        allow read: if isSignedIn() && isChatMemberById(chatId);
        allow create: if isSignedIn() &&
          request.resource.data.senderId == request.auth.uid &&
          isChatMemberById(chatId);
        // Sender-only updates; members may only add themselves to readBy.
        allow update: if isSignedIn() && isChatMemberById(chatId) && (
          (resource.data.senderId == request.auth.uid &&
            messageSenderUpdateAllowed(resource.data, request.resource.data)) ||
          readByChangeAllowed(resource.data, request.resource.data)
        );
        allow delete: if isSignedIn() && isChatMemberById(chatId) && (
          resource.data.senderId == request.auth.uid ||
          isGameChatOwnerById(chatId) ||
          (chatDataById(chatId).type != 'game' && isChatMemberById(chatId))
        );
      }
    }

    match /games/{document} {
      allow create: if isSignedIn() &&
        request.resource.data.uid is string &&
        request.resource.data.uid == request.auth.uid &&
        userRefMatchesUid(request.resource.data) &&
        request.resource.data.joined_players is list &&
        containsSelf(request.resource.data.joined_players) &&
        maxPlayers(request.resource.data) >= totalPlayers(request.resource.data) &&
        isValidStatus(request.resource.data) &&
        isCancelStatusConsistent(request.resource.data);
      // All reads require auth. Public games are visible to any signed-in user.
      // Friends-only games are visible only to the owner, participants, or friends of the owner.
      allow read: if isSignedIn() && (
        isPublicGame(resource.data) ||
        isOwner(resource.data) ||
        isParticipant(resource.data) ||
        isFriendOfOwner(resource.data)
      );
      allow update: if ownerUpdateAllowed() ||
        participantJoinAllowed() ||
        participantLeaveAllowed();
      allow delete: if false;
    }

    match /friend_request/{document} {
      allow create: if isSignedIn() &&
        isSelfReference(request.resource.data.requester_id) &&
        request.resource.data.receiver_id != null &&
        request.resource.data.receiver_id != request.resource.data.requester_id;
      allow read: if isFriendRequestParticipant(resource.data);
      allow update: if isFriendRequestParticipant(resource.data) &&
        request.resource.data.requester_id == resource.data.requester_id &&
        request.resource.data.receiver_id == resource.data.receiver_id;
      allow delete: if isFriendRequestParticipant(resource.data);
    }

    match /usernames/{name} {
      allow create: if request.auth != null &&
        (request.resource.data.uid == userRef(request.auth.uid) ||
         request.resource.data.uid == request.auth.uid) &&
        !exists(/databases/$(database)/documents/usernames/$(name));
      allow read: if request.auth != null;
      allow update: if false;
      allow delete: if false;
    }

    match /user_push_notifications/{id} {
      allow read, update, delete: if false;
      allow create: if false;
    }

    // Alert Subscriptions - users can read/write their own subscriptions
    match /alertSubs/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
